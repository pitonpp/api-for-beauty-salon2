# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=salon

# JWT
SECRET=change_me_random_secret
SECRET_KEY=change_me_random_secret_key
REFRESH_SECRET_KEY=change_me_random_refresh_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First superuser
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_FIRST_NAME=Admin
FIRST_SUPERUSER_LAST_NAME=Admin
FIRST_SUPERUSER_PASSWORD=change_me
FIRST_SUPERUSER_PHONENUMBER=+79000000000

# First regular user
FIRST_USER_USERNAME=user
FIRST_USER_EMAIL=user@example.com
FIRST_USER_FIRST_NAME=User
FIRST_USER_LAST_NAME=User
FIRST_USER_PASSWORD=change_me
FIRST_USER_PHONENUMBER=+79000000001

# First master
FIRST_MASTER_USERNAME=master
FIRST_MASTER_EMAIL=master@example.com
FIRST_MASTER_FIRST_NAME=Master
FIRST_MASTER_LAST_NAME=Master
FIRST_MASTER_PASSWORD=change_me
FIRST_MASTER_PHONENUMBER=+79000000002

# Celery
BROKER_URL=redis://localhost:9999/0
CELERY_BACKEND_RESULT=redis://localhost:9999/1

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_ATTEMPTS=3
RABBITMQ_DELIVERY_MODE=2

FLOWER_PORT=4444
FLOWER_BASIC_AUTH=test:test
FLOWER_BROKER_API=http://test:testpass@rabbitmq:15672/api/
FLOWER_URL_PREFIX=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=false
