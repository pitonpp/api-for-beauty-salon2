# PostgreSQL (локальный или контейнер для тестов)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test_db

# JWT
SECRET=test_secret_key_for_tests
SECRET_KEY=test_secret_key_for_tests
REFRESH_SECRET_KEY=test_refresh_secret_for_tests
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First superuser
FIRST_SUPERUSER_USERNAME=test_admin
FIRST_SUPERUSER_EMAIL=test_admin@example.com
FIRST_SUPERUSER_FIRST_NAME=Test
FIRST_SUPERUSER_LAST_NAME=Admin
FIRST_SUPERUSER_PASSWORD=test_admin_pass
FIRST_SUPERUSER_PHONENUMBER=+79111111111

# First regular user
FIRST_USER_USERNAME=test_user
FIRST_USER_EMAIL=test_user@example.com
FIRST_USER_FIRST_NAME=Test
FIRST_USER_LAST_NAME=User
FIRST_USER_PASSWORD=test_user_pass
FIRST_USER_PHONENUMBER=+79111111112

# First master
FIRST_MASTER_USERNAME=test_master
FIRST_MASTER_EMAIL=test_master@example.com
FIRST_MASTER_FIRST_NAME=Test
FIRST_MASTER_LAST_NAME=Master
FIRST_MASTER_PASSWORD=test_master_pass
FIRST_MASTER_PHONENUMBER=+79111111113

# Celery
BROKER_URL=memory://

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_ATTEMPTS=3
RABBITMQ_DELIVERY_MODE=2

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM_EMAIL=test@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=false
